<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="view_estate_offer_warning_wizard_form" model="ir.ui.view">
		<field name="name">estate.offer.warning.wizard.form</field>
		<field name="model">estate.offer.warning.wizard</field>
		<field name="arch" type="xml">
			<form string="Low Offer Warning">
				<sheet>
					<group>
						<field name="message" readonly="1" nolabel="1"/>
					</group>
				</sheet>
				<footer>
					<button name="action_accept_anyway"
							type="object"
							string="Accept anyway"
							class="btn-primary"/>
					<button name="action_discard"
							type="object"
							string="Discard"
							class="btn-secondary"/>
				</footer>
			</form>
		</field>
	</record>
</odoo>
